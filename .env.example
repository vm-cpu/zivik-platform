# Copy to .env.local and fill in. Never commit real secrets.

# Public site origin — used for canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Let search engines index this deployment. Unset or anything other than
# "true" means every page is served with noindex and robots.txt stops
# advertising the sitemap. Set this to true in the Vercel project on the day
# the archive goes public — every build prints which mode it is in.
# SITE_INDEXABLE=true

# Publish the glossary. Unset or anything other than "true" hides it
# completely: the /glossary route 404s, the «Словник» band disappears from
# every decision page, the inline term marks in the summaries go back to plain
# text, and the header, footer and sitemap stop pointing at it.
#
# Set this on STAGING only, until every headword carries a verbatim definition
# and its source. Production leaves it unset. Every build prints which mode it
# is in. See src/lib/flags.ts.
# FEATURE_GLOSSARY=true

# ── Payload CMS (added when the admin is set up; see docs/ARCHITECTURE.md) ──
# PAYLOAD_SECRET=
# DATABASE_URI=postgres://user:password@localhost:5432/nasvitlo
